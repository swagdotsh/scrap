<Window x:Class="Scrap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="scrap">
  <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="180" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Now Playing" Tag="playing" Icon="Play" IsSelected="True" />
        <NavigationViewItem Content="Reports" Tag="reports"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB05;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Scrobbles" Tag="recent" Icon="Clock" />
        <NavigationViewItem Content="Profile" Tag="profile" Icon="Contact" />
        <NavigationViewItem Content="Friends" Tag="friends" Icon="People" />
      </NavigationView.MenuItems>
      <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock x:Name="Heading" Text="Now Playing" Style="{ThemeResource TitleTextBlockStyle}"/><Button x:Name="RefreshButton" Content="Refresh" HorizontalAlignment="Right" Click="Refresh" /></Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="20">
            <StackPanel x:Name="PlayingPanel" Spacing="16">
              <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="160" Height="160" VerticalAlignment="Top" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid><FontIcon Glyph="&#xE8D6;" FontSize="44"/><Image x:Name="AlbumArtwork" Stretch="UniformToFill" AutomationProperties.Name="Album artwork"/></Grid>
              </Border>
                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                  <TextBlock FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"><Hyperlink x:Name="SongLink" Foreground="{ThemeResource TextFillColorPrimaryBrush}" UnderlineStyle="None"><Run x:Name="TrackTitle" Text="Nothing playing"/></Hyperlink></TextBlock>
                  <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Hyperlink x:Name="ArtistLink" Foreground="{ThemeResource TextFillColorSecondaryBrush}" UnderlineStyle="None"><Run x:Name="ArtistName"/></Hyperlink><Run x:Name="AlbumSeparator"/><Hyperlink x:Name="AlbumLink" Foreground="{ThemeResource TextFillColorSecondaryBrush}" UnderlineStyle="None"><Run x:Name="AlbumName"/></Hyperlink><Run x:Name="TitleNote" FontStyle="Normal"/>
                  </TextBlock>
                </StackPanel>
              </Grid>
              <ProgressBar x:Name="Progress" Maximum="1" Value="0" AutomationProperties.Name="Scrobble progress" />
              <TextBlock x:Name="TrackDetails" TextWrapping="Wrap" />
              <TextBlock x:Name="PlaybackStatus" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="TrackLoved" Text="✓ Loved" Visibility="Collapsed" VerticalAlignment="Center"/><Button Content="Love" Click="Love"/><Button Content="Unlove" Click="Unlove"/><Button Content="Open on last.fm" Click="OpenTrack"/><Button Content="Share" Click="ShareTrack"/></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Tag track…" Click="TagTrack"/><Button Content="Tag artist…" Click="TagArtist"/></StackPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="TrackTags" Orientation="Horizontal" Spacing="6"/></ScrollViewer>
              <StackPanel x:Name="ArtistSection" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="ArtistHeading" FontSize="22" FontWeight="SemiBold"/>
                <Image x:Name="ArtistPortrait" Width="112" Height="112" HorizontalAlignment="Left" Stretch="UniformToFill" Visibility="Collapsed" AutomationProperties.Name="Artist portrait"/>
                <TextBlock x:Name="ArtistBiography" TextWrapping="Wrap"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ArtistTags" Orientation="Horizontal" Spacing="6"/></ScrollViewer>
                <TextBlock Text="Top tracks" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel x:Name="ArtistTopTracks" Spacing="6"/>
                <TextBlock Text="Top albums" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel x:Name="ArtistTopAlbums" Spacing="6"/>
                <Grid><TextBlock Text="Similar artists" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"><Button Content="&#x2039;" Click="PreviousSimilar" AutomationProperties.Name="Previous similar artists"/><Button Content="&#x203A;" Click="NextSimilar" AutomationProperties.Name="Next similar artists"/></StackPanel></Grid>
                <ScrollViewer x:Name="SimilarScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="SimilarArtists" Orientation="Horizontal" Spacing="12"/></ScrollViewer>
                <StackPanel x:Name="ArtistLinks" Orientation="Horizontal" Spacing="8"/>
                <TextBlock x:Name="DetailsStatus" TextWrapping="Wrap" Opacity="0.65"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ResultsPanel" Spacing="12" Visibility="Collapsed" />
            <StackPanel x:Name="SettingsPanel" Spacing="16" Visibility="Collapsed">
              <TabView x:Name="SettingsTabs" Height="430" SelectionChanged="SettingsTabChanged">
                <TabViewItem Header="General">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14" Margin="8,12">
                    <CheckBox x:Name="StartupCheck" Content="Open scrap on login (window stays in tray)" Click="ToggleStartup"/>
                    <ToggleSwitch x:Name="ScrobblingSwitch" Header="Scrobbling" OnContent="On" OffContent="Off" IsOn="True" Toggled="ToggleScrobbling"/>
                    <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                    <StackPanel Spacing="2"><CheckBox x:Name="MilestonesCheck" Content="Milestones" IsChecked="True" Click="NotificationPreferencesChanged"/><TextBlock x:Name="MilestonesNote" Margin="28,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <StackPanel Spacing="2"><CheckBox x:Name="NewArtistsCheck" Content="New artist discovered" IsChecked="True" Click="NotificationPreferencesChanged"/><TextBlock Text="When you scrobble an artist for the first time." Margin="28,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <StackPanel Spacing="2"><CheckBox x:Name="WeeklyReportCheck" Content="Reports" IsChecked="True" Click="NotificationPreferencesChanged"/><TextBlock x:Name="WeeklyReportNote" Margin="28,0,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold"/><ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
                    <TextBlock Text="Scrobble metadata cleanup" FontWeight="SemiBold"/>
                    <CheckBox x:Name="FirstArtistCheck" Content="Use the first artist only" Click="CleanupChanged"/>
                    <CheckBox x:Name="AlbumSuffixCheck" Content="Remove album suffixes" Click="CleanupChanged"/>
                    <CheckBox x:Name="AppleMusicEditionCheck" Content="Include (Apple Music Edition)" Margin="20,0,0,0" Visibility="Collapsed" Click="CleanupChanged"/>
                    <CheckBox x:Name="FeaturedArtistsCheck" Content="Remove “(feat.)” and “(with)” from song titles" Click="CleanupChanged"/>
                    <TextBlock Text="Album artwork" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AnimatedCoversCheck" Content="Animate Now Playing album covers" IsChecked="True" Click="ArtworkPreferencesChanged"/>
                    <CheckBox x:Name="PreferAnimatedCoversCheck" Content="Prefer animated covers when available" Margin="20,0,0,0" Click="ArtworkPreferencesChanged"/>
                    <StackPanel x:Name="PreserveArtistsPanel" Spacing="6" Visibility="Collapsed"><TextBlock Text="Artists to preserve (one per line)"/><TextBox x:Name="PreservedArtistsBox" AcceptsReturn="True" MinHeight="72" PlaceholderText="Earth, Wind &amp; Fire" TextChanged="PreservedArtistsChanged"/></StackPanel>
                    <TextBlock x:Name="CleanupPreview" TextWrapping="Wrap" Opacity="0.75"/>
                    <Button Content="Retry pending scrobbles" Click="Retry" HorizontalAlignment="Left" />
                  </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem Header="last.fm Accounts">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14" Margin="8,12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <Border Width="72" Height="72" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image x:Name="AccountAvatar" Stretch="UniformToFill" AutomationProperties.Name="last.fm profile picture"/></Border>
                      <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="last.fm account" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AccountInfo" Text="Not connected" TextWrapping="Wrap"/><HyperlinkButton x:Name="AccountProfileLink" Content="Open last.fm profile" Visibility="Collapsed" HorizontalAlignment="Left" Padding="0"/></StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="AccountControls" Orientation="Horizontal" Spacing="8">
                      <Button x:Name="ConnectButton" Content="Connect last.fm" Click="Connect"/>
                      <Button x:Name="ApproveButton" Content="I've approved it" Click="Approve" Visibility="Collapsed"/>
                      <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem Header="Services">
                  <StackPanel Spacing="10" Margin="12"><TextBlock Text="Spotify" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Spotify support is coming soon." TextWrapping="Wrap"/></StackPanel>
                </TabViewItem>
                <TabViewItem Header="Discord">
                  <Grid ColumnSpacing="16" Margin="8,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12" Padding="0,0,16,0">
                      <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="DiscordSwitch" Header="Show what I'm listening to on Discord" OnContent="On" OffContent="Off"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse x:Name="DiscordStatusDot" Width="8" Height="8" Margin="0,5,0,0" VerticalAlignment="Top"/><TextBlock x:Name="DiscordStatusText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
                      </StackPanel>
                      <TextBlock Text="Text" FontWeight="SemiBold"/>
                      <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Track line" VerticalAlignment="Center"/><TextBox x:Name="DiscordDetailsBox" Grid.Column="1" PlaceholderText="Hidden" AutomationProperties.Name="Track line"/><DropDownButton x:Name="DiscordDetailsPresets" Grid.Column="2" AutomationProperties.Name="Track line presets"><FontIcon Glyph="&#xE8FD;" FontSize="14"/></DropDownButton>
                        <TextBlock Grid.Row="1" Text="Artist line" VerticalAlignment="Center"/><TextBox x:Name="DiscordStateBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Hidden" AutomationProperties.Name="Artist line"/><DropDownButton x:Name="DiscordStatePresets" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="Artist line presets"><FontIcon Glyph="&#xE8FD;" FontSize="14"/></DropDownButton>
                        <TextBlock Grid.Row="2" Text="Album line" VerticalAlignment="Center"/><TextBox x:Name="DiscordAlbumBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Hidden" AutomationProperties.Name="Album line"/><DropDownButton x:Name="DiscordAlbumPresets" Grid.Row="2" Grid.Column="2" AutomationProperties.Name="Album line presets"><FontIcon Glyph="&#xE8FD;" FontSize="14"/></DropDownButton>
                      </Grid>
                      <TextBlock Text="Use {title}, {artist}, {album} and {service}. A line is hidden when a token in it is empty, such as a song without an album." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      <ComboBox x:Name="DiscordStatusChoice" Header="“Listening to …” shows"/>
                      <TextBlock Text="Display" FontWeight="SemiBold"/>
                      <CheckBox x:Name="DiscordCoverCheck" Content="Show the album cover"/>
                      <StackPanel x:Name="DiscordCoverOptions" Spacing="4" Margin="28,0,0,0">
                        <ComboBox x:Name="DiscordCoverChoice" Header="Cover from"><ComboBoxItem Content="last.fm"/><ComboBoxItem Content="Apple Music (your artwork)"/></ComboBox>
                        <TextBlock x:Name="DiscordCoverNote" Text="Uses the artwork Apple Music shows, including custom covers. Discord can only show covers from a web link, so the artwork is uploaded to litterbox.catbox.moe, where it's public to anyone with the link and expires after 72 hours. Falls back to last.fm when a song has no artwork." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                      <CheckBox x:Name="DiscordTimeCheck" Content="Show the time bar"/>
                      <CheckBox x:Name="DiscordLinksCheck" Content="Link the track, artist and album to last.fm"/>
                      <CheckBox x:Name="DiscordCleanupCheck" Content="Use the scrobble metadata cleanup options from General"/>
                      <ComboBox x:Name="DiscordPausedChoice" Header="When paused"><ComboBoxItem Content="Hide activity"/><ComboBoxItem Content="Keep it, without the time bar"/></ComboBox>
                      <TextBlock Text="Buttons" FontWeight="SemiBold"/>
                      <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <ComboBox x:Name="DiscordButton1Choice" Header="First button" HorizontalAlignment="Stretch"/><TextBox x:Name="DiscordButton1Label" Grid.Column="1" Header="Label" MaxLength="32" VerticalAlignment="Bottom"/>
                        <ComboBox x:Name="DiscordButton2Choice" Grid.Row="1" Header="Second button" HorizontalAlignment="Stretch"/><TextBox x:Name="DiscordButton2Label" Grid.Row="1" Grid.Column="1" Header="Label" MaxLength="32" VerticalAlignment="Bottom"/>
                      </Grid>
                      <TextBlock Text="Discord doesn't show buttons on your own profile, only to other people. Spotify opens a Spotify search for the song. Apple Music is left out when the song isn't in Apple's catalog, and song.link falls back to last.fm." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Column="1" Spacing="10"><TextBlock Text="Preview" FontWeight="SemiBold"/><StackPanel x:Name="DiscordPreview" Spacing="8"/></StackPanel>
                  </Grid>
                </TabViewItem>
                <TabViewItem Header="Updates">
                  <StackPanel Spacing="12" Margin="12">
                    <TextBlock x:Name="InstalledVersion" FontSize="20" FontWeight="SemiBold"/>
                    <Button Content="Check for updates" Click="CheckUpdates" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="DailyUpdateCheck" Content="Check for updates daily" IsChecked="True" Click="UpdatePreferencesChanged"/>
                    <CheckBox x:Name="AutoInstallUpdates" Content="Automatically install verified updates" Click="UpdatePreferencesChanged"/>
                    <TextBlock x:Name="UpdateCheckStatus" TextWrapping="Wrap" Opacity="0.75"/>
                  </StackPanel>
                </TabViewItem>
              </TabView>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="6">
          <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True"/>
          <StackPanel x:Name="MainAccountControls" Orientation="Horizontal" Spacing="8">
            <Button x:Name="MainConnectButton" Content="Connect last.fm" Click="Connect"/>
            <Button x:Name="MainApproveButton" Content="I've approved it" Click="Approve" Visibility="Collapsed"/>
            <Button x:Name="MainSignOutButton" Content="Sign out" Click="SignOut" Visibility="Collapsed"/>
          </StackPanel>
          <TextBlock x:Name="MainAccountStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
