<Application x:Class="Scrap.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFF3F5F8" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF20232A" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF555B66" />
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF7046A8" />
          <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF613995" />
          <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFDDE1E8" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
